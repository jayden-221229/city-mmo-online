{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,shared/**,assets/**,index.html}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js?__path=/$1"
    }
  ]
}
